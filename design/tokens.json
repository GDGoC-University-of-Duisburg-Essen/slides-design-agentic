{
  "$comment": "Design tokens of the GDG on Campus UDE slide design. Single source of truth for colors, type scale and geometry. Pixel values refer to the 1920x1080 canvas (1 pt = 2 px, 1 px = 6350 EMU).",
  "canvas": {
    "width_px": 1920,
    "height_px": 1080,
    "aspect": "16:9",
    "pptx_width_in": 13.333,
    "pptx_height_in": 7.5,
    "px_per_pt": 2
  },
  "colors": {
    "brand": {
      "blue": "#4285F4",
      "red": "#EA4335",
      "yellow": "#F9AB00",
      "green": "#34A853"
    },
    "light": {
      "background": "#FFFFFF",
      "surface": "#F8F9FA",
      "surface_2": "#F1F3F4",
      "text": "#1E1E1E",
      "text_muted": "#5F6368",
      "line": "#DADCE0",
      "accent_text": "#1A73E8",
      "on_brand": "#FFFFFF",
      "on_yellow": "#1E1E1E",
      "logo": "assets/logo/gdg_ude_logo_darktext_trimmed.png"
    },
    "dark": {
      "background": "#202124",
      "surface": "#2A2B2E",
      "surface_2": "#35363A",
      "text": "#E8EAED",
      "text_muted": "#9AA0A6",
      "line": "#3C4043",
      "accent_text": "#8AB4F8",
      "on_brand": "#FFFFFF",
      "on_yellow": "#1E1E1E",
      "logo": "assets/logo/gdg_ude_logo_lighttext_trimmed.png"
    },
    "accent_cycle": ["blue", "red", "yellow", "green"]
  },
  "fonts": {
    "sans": "Google Sans",
    "sans_medium": "Google Sans Medium",
    "mono": "Google Sans Code",
    "fallback_sans": "Arial, Helvetica, sans-serif",
    "fallback_mono": "Consolas, 'DejaVu Sans Mono', monospace",
    "files": "assets/fonts/"
  },
  "type_scale_pt": {
    "display": { "size": 54, "weight": 700, "use": "title slide, chapter title, outro" },
    "slide_title": { "size": 36, "weight": 500, "use": "title of every content slide (max. 2 lines)" },
    "subtitle": { "size": 28, "weight": 400, "use": "subtitles, lead text, agenda items" },
    "statement": { "size": 44, "weight": 500, "use": "statement / quote slide" },
    "fact": { "size": 66, "weight": 700, "use": "big numbers on key-facts slide" },
    "body": { "size": 24, "weight": 400, "use": "bullets and body text (level 1)" },
    "body_2": { "size": 20, "weight": 400, "use": "bullet level 2, table text, column text in dense slides" },
    "code": { "size": 18, "weight": 400, "use": "code blocks (Google Sans Code)" },
    "small": { "size": 16, "weight": 400, "use": "captions, references, source notes - absolute minimum for content" },
    "footer": { "size": 12, "weight": 400, "use": "footer meta line and slide number area only" },
    "eyebrow": { "size": 16, "weight": 700, "use": "small uppercase labels, letter-spacing 0.08em" }
  },
  "line_height": { "tight": 1.1, "title": 1.15, "body": 1.35 },
  "content_rules": {
    "$comment": "Used by the linters (html/gdg-slides.js keeps a copy - keep in sync). See docs/content-guidelines.md.",
    "max_words": { "default": 60, "full": 70, "two-columns": 70, "code": 35, "canvas": 40, "image": 25,
      "facts": 50, "statement": 30, "agenda": 50, "references": 9999, "title": 30, "chapter": 25,
      "outro": 45, "next-event": 45 },
    "min_words_without_visual": 8,
    "max_bullets": 6,
    "max_words_per_bullet": 22,
    "max_list_depth": 2,
    "max_title_words": 14,
    "max_title_lines": 2,
    "max_agenda_items": 8,
    "max_references_per_slide": 16,
    "max_code_lines": 15,
    "max_code_line_chars": 80,
    "min_font_pt": 16
  },
  "geometry_px": {
    "margin_x": 112,
    "title_bar": { "x": 112, "y": 88, "w": 128, "h": 8 },
    "title": { "x": 112, "y": 120, "w": 1600 },
    "content": { "x": 112, "y": 288, "w": 1696, "bottom": 936 },
    "footer": { "logo_x": 112, "center_y": 1024, "logo_h": 40, "meta_x": 480 },
    "number_bubble": { "cx": 1920, "cy": 1080, "r": 136 },
    "radius": { "card": 24, "image": 24, "chip": 999 }
  }
}
